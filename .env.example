# Copy to .env.local. Never commit secrets.

# --- Firebase client (public) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mpexperience.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mpexperience
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mpexperience.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=604236537968
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server) ---
FIREBASE_PROJECT_ID=mpexperience
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Edvisor (server-only Bearer; dual hosts, no blind fallback) ---
EDVISOR_API_KEY=
# API v2 (catalog, generateQuotePrice, enrollments)
EDVISOR_API_V2_URL=https://api-v2.edvisor.io/graphql
# Federation Gateway (searchLanguageCourses, addons, accommodationPrice)
EDVISOR_GATEWAY_URL=https://federation-gateway.edvisor.io/graphql
# Prior integration reference — verify with current agency account before relying on it
EDVISOR_AGENCY_ID=1451
# EDVISOR_OFFICE_ID=

# --- Stripe (Checkout only; webhook signature REQUIRED) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Marco Polo Experience <onboarding@resend.dev>
BOOKING_FROM_EMAIL=reservas@marcopoloexperience.com
MPE_INTERNAL_EMAIL=procesos@marcopoloeducation.com

# --- App ---
NEXT_PUBLIC_APP_URL=http://127.0.0.1:4317
# Cron shared secret for authenticated job batches
CRON_SECRET=

# --- Persistence ---
# Local JSON writes (curation/catalog) ONLY outside production when set to 1.
# Production must use Firestore. Never treat JSON as prod persistence.
# ALLOW_LOCAL_PERSISTENCE=1
