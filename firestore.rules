rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowlistedAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@marcopoloeducation.com';
    }

    match /curation/{docId} {
      allow read: if true;
      allow write: if isAllowlistedAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
